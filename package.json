{
  "name": "veyr",
  "private": true,
  "version": "0.0.0",
  "description": "Evidence-first observability for coding agents.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter @veyr/core build && pnpm --filter @veyr/codex-adapter build && pnpm --filter @veyr/skill-catalog build && pnpm --filter @veyr/report build && pnpm --filter @veyr/cli build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm --filter @veyr/cli dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "veyr": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.31.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
